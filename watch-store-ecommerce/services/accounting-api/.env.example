APP_NAME=WatchCommerce Accounting API
APP_VERSION=1.0.0
API_PREFIX=/api/v1

DB_ENGINE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accounting_db
DB_USER=postgres
DB_PASSWORD=postgres
SQLITE_PATH=./accounting.db

RABBITMQ_URL=amqp://watchcommerce:watchcommerce@localhost:5672/%2F
RABBITMQ_EXCHANGE=watchcommerce.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE=integration.accounting.order.created
RABBITMQ_ROUTING_KEYS=integration.accounting.order.created
ACCEPTED_ORDER_EVENTS=OrderCreated,order.created
RABBITMQ_RECONNECT_DELAY=5

INVOICE_CURRENCY_DEFAULT=IDR
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
