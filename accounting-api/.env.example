APP_NAME=WatchCommerce Accounting API
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# Choose one:
# 1) Full DATABASE_URL
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/accounting_db
#
# 2) Or compose from DB_ENGINE + DB_* variables
DB_ENGINE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accounting_db
DB_USER=postgres
DB_PASSWORD=postgres
SQLITE_PATH=./accounting.db

RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
RABBITMQ_EXCHANGE=watchcommerce.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE=accounting.order.created
RABBITMQ_ROUTING_KEYS=order.created,OrderCreated
ACCEPTED_ORDER_EVENTS=OrderCreated,order.created
RABBITMQ_RECONNECT_DELAY=5

INVOICE_CURRENCY_DEFAULT=IDR
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
